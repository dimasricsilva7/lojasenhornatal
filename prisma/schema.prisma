generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrderStatus {
  CREATED
  PIX_GENERATED
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  CHARGEBACK
  FAILED
}

enum ProductType {
  MAIN
  COMPLEMENTARY
  ORDER_BUMP
  UPSELL
  DOWNSELL
}

enum CartStatus {
  OPEN
  RECOVERED
  ABANDONED
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model Product {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  campaign          String?     // null = loja principal (home); "arvore-led" = campanha isolada
  description       String?
  priceCents        Int
  compareAtCents    Int?
  bravopayProductId String?
  images            String[]    @default([])
  type              ProductType @default(COMPLEMENTARY)
  active            Boolean     @default(true)
  featured          Boolean     @default(false)
  sortOrder         Int         @default(0)
  orderBumpEnabled  Boolean     @default(false)
  orderBumpPriceCents Int?
  orderBumpHeadline String?
  upsellEnabled     Boolean     @default(false)
  upsellPriceCents  Int?
  upsellHeadline    String?
  shortPitch        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
  reviews           Review[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  cpf       String
  createdAt DateTime @default(now())
  orders    Order[]
  abandonedCarts AbandonedCart[]

  @@index([cpf])
  @@index([phone])
}

model Order {
  id                String      @id @default(cuid())
  displayId         String      @unique
  campaign          String?     // isola pedidos por campanha; null = loja principal
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  status            OrderStatus @default(CREATED)

  shippingZip       String
  shippingAddress   String
  shippingNumber    String
  shippingComplement String?
  shippingNeighborhood String
  shippingCity      String
  shippingState     String

  subtotalCents     Int
  shippingCents     Int         @default(0)
  discountCents     Int         @default(0)
  totalCents        Int

  gateway           String      @default("bravopay") // bravopay | infinitepay
  bravopayTransactionId String? @unique
  pixCopyPaste      String?
  pixExpiresAt      DateTime?
  checkoutUrl       String?     // URL do checkout hospedado (InfinitePay)
  idempotencyKey    String      @unique

  paidAt            DateTime?
  pixelPurchaseFiredAt DateTime?
  trackingCode      String?     // código de rastreio Translog
  trackingStatus    String?     // processed | pending_credits | error
  lastCheckedAt     DateTime?
  isUpsellOrder     Boolean     @default(false)
  parentOrderId     String?

  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  fbclid            String?
  gclid             String?
  ttclid            String?
  metaEventId       String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
  payments          Payment[]
  trackingEvents    TrackingEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  kind        String   @default("main") // main | order_bump | upsell
  quantity    Int      @default(1)
  unitPriceCents Int
  totalCents  Int

  @@index([orderId])
}

model Payment {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bravopayTransactionId String   @unique
  status                String
  amountCents           Int
  netCents              Int?
  feeCents              Int?
  method                String   @default("pix")
  rawPayload            Json?
  createdAt             DateTime @default(now())

  @@index([orderId])
}

model AbandonedCart {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  customerName  String
  email         String
  phone         String
  orderId       String?    @unique
  cartValueCents Int
  status        CartStatus @default(OPEN)
  recoveredAt   DateTime?
  emailSentAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([email])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  eventName  String
  eventId    String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  utmContent String?
  utmTerm    String?
  fbclid     String?
  gclid      String?
  path       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventName])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("bravopay")
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Review {
  id               String   @id @default(cuid())
  customerName     String
  city             String?
  state            String?
  rating           Int
  testimonial      String
  photoUrl         String?
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  verifiedPurchase Boolean  @default(false)
  published        Boolean  @default(false)
  featured         Boolean  @default(false)
  reviewDate       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published])
  @@index([productId])
}

// Visitantes do site (aba "Online agora" do admin). id = id de sessão gerado no navegador.
model Visitor {
  id          String   @id
  path        String?
  landingPage String?
  section     String?
  device      String?
  source      String?
  campaign    String?
  pageViews   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// Prova social da página (imagens e vídeos 9:16 escolhidos no admin por link).
model SocialProof {
  id        String   @id @default(cuid())
  mediaType String   @default("image") // image | video
  url       String
  caption   String?
  name      String?
  city      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// ──────────────────────────────────────────────────────────────────
// CAMPANHA ATACADO DE PANETONE (página /atacado-panetone)
// Tabela 100% independente: leads dessa campanha NÃO se misturam com
// os pedidos da loja (árvore de Natal) nem com outras campanhas.
// ──────────────────────────────────────────────────────────────────
model AtacadoLead {
  id           String   @id @default(cuid())
  campaign     String   @default("atacado-panetone")
  name         String
  phone        String
  email        String?
  buyerType    String   @default("empresa") // empresa | doacao | revenda | pessoal
  company      String?
  city         String?

  // Snapshot do orçamento montado na página
  items        Json     // [{ id, name, group, qty, unitCents, totalCents, unit, boxSize }]
  totalCents   Int      @default(0)
  sinalCents   Int      @default(0)
  totalPieces  Int      @default(0)
  message      String?

  status       String   @default("NOVO") // NOVO | CONTATADO | ORCAMENTO | SINAL_PAGO | FECHADO | PERDIDO
  adminNote    String?
  whatsappSent Boolean  @default(false)

  // Atribuição (mesmo cookie "attribution" do site)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fbclid       String?
  path         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaign, createdAt])
  @@index([status])
}
